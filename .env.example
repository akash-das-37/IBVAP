# ===================================================
# IBVAP Configuration File
# ===================================================

# Camera Stream Configuration
# Options:
# 1. Smartphone RTSP: rtsp://192.168.1.50:8080/h264_pcm.sdp
# 2. Smartphone MJPEG: http://192.168.1.50:8080/video
# 3. Built-in Webcam: 0
# 4. Fallback Demo Video: data/demo_videos/sample_border.mp4
CAMERA_SOURCE=0
CAMERA_ID=CAM-01
CAMERA_NAME=Main Perimeter Camera
CAMERA_LOCATION=North Border Test Sector

# Operation Mode: 'live' or 'demo'
MODE=live

# AI Pipeline Settings
YOLO_MODEL=yolov8n.pt
CONFIDENCE_THRESHOLD=0.45
IOU_THRESHOLD=0.45
ENABLE_LOW_LIGHT_CLAHE=false
ENABLE_ANPR=true

# Edge Motion Detection Filter (Lightweight Pre-filter)
MOTION_FILTER_ENABLED=true
MOTION_SENSITIVITY=25
MIN_MOTION_AREA=500

# Rule Engine Thresholds
DWELL_THRESHOLD_SECONDS=10.0

# Redis / Queue Settings
# If Redis is running on localhost:6379, it will be used.
# If unavailable, IBVAP automatically falls back to an internal async queue.
REDIS_URL=redis://localhost:6379/0

# Database
DATABASE_URL=sqlite:///./data/ibvap.db

# Server Config
HOST=0.0.0.0
PORT=8000
FRONTEND_PORT=5173
DEBUG=true
